import flet as ft

def main(page: ft.Page):
    page.title = "Arcadia Study App"
    page.padding = 0
    page.bgcolor = "#F8FAFC"
    page.theme_mode = ft.ThemeMode.LIGHT

    # Color Palette
    PRIMARY_TEAL = "#0F7A71"
    LIGHT_TEAL = "#E6F2F1"
    TEXT_DARK = "#111827"
    TEXT_GREY = "#6B7280"
    BORDER_COLOR = "#E5E7EB"
    DARK_BANNER = "#0B2B26"

    # State: Active Tab ('flashcards' or 'ai')
    active_tab = "flashcards"

    # Container that will dynamically update content
    main_content_container = ft.Container(expand=True)

    # --- SIDEBAR COMPONENTS ---
    def nav_item(icon, text, tab_name, badges=None):
        is_active = (active_tab == tab_name)
        content_row = [
            ft.Icon(icon, color=PRIMARY_TEAL if is_active else TEXT_GREY, size=20),
            ft.Text(text, weight=ft.FontWeight.W_600 if is_active else ft.FontWeight.W_500, color=PRIMARY_TEAL if is_active else TEXT_DARK, size=14),
        ]
        if badges:
            content_row.append(
                ft.Container(
                    content=ft.Text(badges, size=10, color=TEXT_GREY),
                    bgcolor=BORDER_COLOR,
                    padding=ft.Padding(6, 2, 6, 2),
                    border_radius=10,
                    margin=ft.Margin(8, 0, 0, 0)
                )
            )
        return ft.Container(
            content=ft.Row(content_row),
            bgcolor=LIGHT_TEAL if is_active else ft.Colors.TRANSPARENT,
            padding=ft.Padding(12, 10, 12, 10),
            border_radius=8,
            margin=ft.Margin(0, 0, 0, 4),
            ink=True,
            on_click=lambda _: switch_tab(tab_name)
        )

    def chat_item(text):
        return ft.Container(
            content=ft.Row([
                ft.Icon(ft.Icons.CHAT_BUBBLE_OUTLINE, size=16, color=TEXT_GREY),
                ft.Text(text, size=13, color=TEXT_GREY, no_wrap=True)
            ]),
            padding=ft.Padding(12, 8, 12, 8)
        )

    # Sidebar Re-render Function
    sidebar_container = ft.Container(width=260, bgcolor=ft.Colors.WHITE, padding=20, border=ft.Border(right=ft.BorderSide(1, BORDER_COLOR)))

    def render_sidebar():
        sidebar_container.content = ft.Column([
            ft.Row([
                ft.Container(
                    content=ft.Icon(ft.Icons.MENU_BOOK, color=ft.Colors.WHITE, size=20),
                    bgcolor="#1E293B", padding=6, border_radius=6
                ),
                ft.Text("Arcadia", size=22, weight=ft.FontWeight.BOLD, color=TEXT_DARK)
            ], margin=ft.Margin(0, 0, 0, 24)),
            
            ft.Button(
                content=ft.Text("+ New study chat", color=ft.Colors.WHITE, weight=ft.FontWeight.W_600),
                bgcolor=PRIMARY_TEAL,
                width=float("inf"),
                style=ft.ButtonStyle(shape=ft.RoundedRectangleBorder(radius=8), padding=16),
                on_click=lambda _: switch_tab("ai")
            ),
            ft.Divider(height=24, color=ft.Colors.TRANSPARENT),
            
            nav_item(ft.Icons.AUTO_AWESOME, "AI Assistant", "ai"),
            nav_item(ft.Icons.STYLE, "Flashcards", "flashcards"),
            nav_item(ft.Icons.CALENDAR_TODAY, "Study planner", "planner", badges="To-do · Calendar"),
            nav_item(ft.Icons.TIMER, "Study timer", "timer"),
            nav_item(ft.Icons.PERSON, "Profile", "profile"),
            
            ft.Container(
                content=ft.Row([
                    ft.Icon(ft.Icons.SYNC, size=14, color=TEXT_GREY),
                    ft.Text("To-do list and calendar stay in\nsync", size=11, color=TEXT_GREY)
                ]),
                margin=ft.Margin(0, 16, 0, 24)
            ),
            
            ft.Text("RECENT CHATS", size=11, weight=ft.FontWeight.BOLD, color=TEXT_GREY, margin=ft.Margin(12, 0, 0, 8)),
            ft.Column([
                chat_item("New study chat"),
                chat_item("New study chat"),
                chat_item("New study chat"),
                chat_item("What is E=mc²?"),
                chat_item("Help with my I2P question"),
            ], spacing=0, expand=True),
            
            ft.Container(
                content=ft.Row([
                    ft.CircleAvatar(content=ft.Text("JD", size=12, color=TEXT_DARK), bgcolor=BORDER_COLOR, radius=18),
                    ft.Column([
                        ft.Text("John Doe", size=14, weight=ft.FontWeight.W_600, color=TEXT_DARK),
                        ft.Text("View profile", size=12, color=TEXT_GREY)
                    ], spacing=0)
                ]),
                padding=12,
                border=ft.Border(
                    top=ft.BorderSide(1, BORDER_COLOR),
                    bottom=ft.BorderSide(1, BORDER_COLOR),
                    left=ft.BorderSide(1, BORDER_COLOR),
                    right=ft.BorderSide(1, BORDER_COLOR)
                ),
                border_radius=12
            )
        ])

    # --- FLASHCARDS DECKS VIEW ---
    def deck_card(accent_color, title, subtitle, progress_val):
        return ft.Container(
            bgcolor=ft.Colors.WHITE,
            border=ft.Border(
                top=ft.BorderSide(1, BORDER_COLOR),
                bottom=ft.BorderSide(1, BORDER_COLOR),
                left=ft.BorderSide(1, BORDER_COLOR),
                right=ft.BorderSide(1, BORDER_COLOR)
            ),
            border_radius=16,
            padding=20,
            content=ft.Column([
                ft.Container(width=32, height=4, bgcolor=accent_color, border_radius=2, margin=ft.Margin(0, 0, 0, 16)),
                ft.Text(title, size=18, weight=ft.FontWeight.BOLD, color=TEXT_DARK),
                ft.Text(subtitle, size=13, color=TEXT_GREY, margin=ft.Margin(0, 0, 0, 16)),
                ft.ProgressBar(value=progress_val, color=accent_color, bgcolor="#F3F4F6", height=6),
                ft.Container(height=20),
                ft.Row([
                    ft.Button(
                        content=ft.Text("Study", color=ft.Colors.WHITE, size=13, weight=ft.FontWeight.W_600),
                        bgcolor=PRIMARY_TEAL,
                        style=ft.ButtonStyle(shape=ft.RoundedRectangleBorder(radius=8), padding=ft.Padding(16, 8, 16, 8)),
                        on_click=lambda _: switch_tab("ai")
                    ),
                    ft.Button(
                        content=ft.Text("Quiz", color=PRIMARY_TEAL, size=13, weight=ft.FontWeight.W_600),
                        bgcolor=ft.Colors.TRANSPARENT,
                        style=ft.ButtonStyle(shape=ft.RoundedRectangleBorder(radius=8), side=ft.BorderSide(1, BORDER_COLOR), padding=ft.Padding(14, 8, 14, 8))
                    ),
                    ft.Button(
                        content=ft.Text("Edit", color=PRIMARY_TEAL, size=13, weight=ft.FontWeight.W_600),
                        bgcolor=ft.Colors.TRANSPARENT,
                        style=ft.ButtonStyle(shape=ft.RoundedRectangleBorder(radius=8), side=ft.BorderSide(1, BORDER_COLOR), padding=ft.Padding(14, 8, 14, 8))
                    ),
                ], spacing=8)
            ])
        )

    def create_deck_card():
        return ft.Container(
            bgcolor=LIGHT_TEAL,
            border=ft.Border(
                top=ft.BorderSide(1, PRIMARY_TEAL),
                bottom=ft.BorderSide(1, PRIMARY_TEAL),
                left=ft.BorderSide(1, PRIMARY_TEAL),
                right=ft.BorderSide(1, PRIMARY_TEAL)
            ),
            border_radius=16,
            padding=20,
            content=ft.Column([
                ft.Container(
                    content=ft.Icon(ft.Icons.ADD, color=PRIMARY_TEAL, size=24),
                    bgcolor=ft.Colors.WHITE,
                    shape=ft.BoxShape.CIRCLE,
                    width=40,
                    height=40,
                    alignment=ft.Alignment.CENTER,
                    margin=ft.Margin(0, 0, 0, 16)
                ),
                ft.Text("Create new deck", size=16, weight=ft.FontWeight.BOLD, color=PRIMARY_TEAL)
            ], alignment=ft.MainAxisAlignment.CENTER, horizontal_alignment=ft.CrossAxisAlignment.CENTER),
            alignment=ft.Alignment.CENTER,
            ink=True
        )

    def build_flashcards_view():
        header_row = ft.Row([
            ft.Column([
                ft.Text("Flashcards", size=24, weight=ft.FontWeight.BOLD, color=TEXT_DARK),
                ft.Text("Your decks and quizzes", size=14, color=TEXT_GREY)
            ], spacing=4),
            ft.Row([
                ft.Container(
                    content=ft.TextField(
                        hint_text="Search decks",
                        prefix_icon=ft.Icons.SEARCH,
                        text_size=14,
                        border=ft.InputBorder.NONE,
                        bgcolor=ft.Colors.TRANSPARENT,
                        height=36,
                        content_padding=10
                    ),
                    bgcolor="#F3F4F6", border_radius=8, width=240, height=40
                ),
                ft.Button(
                    content=ft.Row([ft.Icon(ft.Icons.AUTO_AWESOME, size=16, color=PRIMARY_TEAL), ft.Text("AI suggested deck", color=PRIMARY_TEAL, weight=ft.FontWeight.W_600)], spacing=6),
                    bgcolor=LIGHT_TEAL, style=ft.ButtonStyle(shape=ft.RoundedRectangleBorder(radius=8), padding=12)
                ),
                ft.Button(
                    content=ft.Text("+ New deck", color=ft.Colors.WHITE, weight=ft.FontWeight.W_600),
                    bgcolor=PRIMARY_TEAL, style=ft.ButtonStyle(shape=ft.RoundedRectangleBorder(radius=8), padding=12)
                )
            ])
        ], alignment=ft.MainAxisAlignment.SPACE_BETWEEN)

        tabs_row = ft.Row([
            ft.Container(
                content=ft.Text("Flashcards", color=PRIMARY_TEAL, weight=ft.FontWeight.W_600),
                bgcolor=ft.Colors.WHITE, padding=ft.Padding(20, 10, 20, 10), border_radius=8,
                shadow=ft.BoxShadow(spread_radius=0, blur_radius=4, color="#0000000D")
            ),
            ft.Container(content=ft.Text("Quiz", color=TEXT_GREY, weight=ft.FontWeight.W_500), padding=ft.Padding(20, 10, 20, 10), border_radius=8)
        ], margin=ft.Margin(0, 24, 0, 24))

        hero_banner = ft.Container(
            bgcolor=DARK_BANNER, border_radius=16, padding=28, margin=ft.Margin(0, 0, 0, 32),
            content=ft.Row([
                ft.Column([
                    ft.Text("Continue studying", size=14, color="#9CA3AF"),
                    ft.Text("GEN PHYS · 4 cards", size=24, weight=ft.FontWeight.BOLD, color=ft.Colors.WHITE)
                ], spacing=8),
                ft.Button(
                    content=ft.Text("Start studying", color=DARK_BANNER, weight=ft.FontWeight.BOLD),
                    bgcolor=LIGHT_TEAL, style=ft.ButtonStyle(shape=ft.RoundedRectangleBorder(radius=8), padding=ft.Padding(20, 12, 20, 12)),
                    on_click=lambda _: switch_tab("ai")
                )
            ], alignment=ft.MainAxisAlignment.SPACE_BETWEEN)
        )

        decks_header = ft.Row([
            ft.Text("My decks", size=20, weight=ft.FontWeight.BOLD, color=TEXT_DARK),
            ft.Text("5 decks", size=14, color=TEXT_GREY)
        ], alignment=ft.MainAxisAlignment.SPACE_BETWEEN, margin=ft.Margin(0, 0, 0, 16))

        decks_grid = ft.GridView(
            runs_count=3, max_extent=340, child_aspect_ratio=1.35, spacing=16, run_spacing=16,
            controls=[
                deck_card(PRIMARY_TEAL, "GEN PHYS", "4 cards · General Physics", 0.6),
                deck_card("#6366F1", "I2P", "3 cards · Introduction to\nProgramming", 0.4),
                deck_card("#F59E0B", "Forms in Nature", "2 cards · Design Studies", 0.7),
                deck_card("#EC4899", "Deadly Elegance", "2 cards · Literature", 0.5),
                deck_card("#3B82F6", "College Chinese", "3 cards · Language", 0.3),
                create_deck_card()
            ]
        )

        return ft.Container(
            padding=40, expand=True,
            content=ft.Column([header_row, tabs_row, hero_banner, decks_header, decks_grid], scroll=ft.ScrollMode.AUTO)
        )

    # --- AI ASSISTANT / FLASHCARD STUDY VIEW ---
    def build_ai_study_view():
        header_row = ft.Row([
            ft.Column([
                ft.Text("Flashcards", size=24, weight=ft.FontWeight.BOLD, color=TEXT_DARK),
                ft.Text("Your decks and quizzes", size=14, color=TEXT_GREY)
            ], spacing=4),
            ft.Row([
                ft.Container(
                    content=ft.TextField(
                        hint_text="Search decks", prefix_icon=ft.Icons.SEARCH, text_size=14,
                        border=ft.InputBorder.NONE, bgcolor=ft.Colors.TRANSPARENT, height=36, content_padding=10
                    ),
                    bgcolor="#F3F4F6", border_radius=8, width=240, height=40
                ),
                ft.Button(content=ft.Text("+ AI suggested deck", color=PRIMARY_TEAL, weight=ft.FontWeight.W_600), bgcolor=LIGHT_TEAL, style=ft.ButtonStyle(shape=ft.RoundedRectangleBorder(radius=8), padding=12)),
                ft.Button(content=ft.Text("+ New deck", color=ft.Colors.WHITE, weight=ft.FontWeight.W_600), bgcolor=PRIMARY_TEAL, style=ft.ButtonStyle(shape=ft.RoundedRectangleBorder(radius=8), padding=12))
            ])
        ], alignment=ft.MainAxisAlignment.SPACE_BETWEEN)

        tabs_row = ft.Row([
            ft.Container(content=ft.Text("Flashcards", color=PRIMARY_TEAL, weight=ft.FontWeight.W_600), padding=ft.Padding(16, 8, 16, 8), border=ft.Border(bottom=ft.BorderSide(2, PRIMARY_TEAL))),
            ft.Container(content=ft.Text("Quiz", color=TEXT_GREY), padding=ft.Padding(16, 8, 16, 8)),
            ft.Container(expand=True),
            ft.Button(
                content=ft.Row([ft.Icon(ft.Icons.ARROW_BACK, size=16, color=TEXT_GREY), ft.Text("Back to decks", color=TEXT_GREY)]),
                bgcolor=ft.Colors.TRANSPARENT,
                on_click=lambda _: switch_tab("flashcards")
            )
        ], margin=ft.Margin(0, 24, 0, 24))

        deck_title = ft.Column([
            ft.Text("GEN PHYS", size=20, weight=ft.FontWeight.BOLD, color=TEXT_DARK),
            ft.Row([ft.Text("General Physics · Flashcard study", color=TEXT_GREY, size=14), ft.Text("Card 1 of 4", color=TEXT_GREY, size=14)], alignment=ft.MainAxisAlignment.SPACE_BETWEEN),
            ft.ProgressBar(value=0.25, color=PRIMARY_TEAL, bgcolor=BORDER_COLOR, height=6)
        ], spacing=8, margin=ft.Margin(0, 0, 0, 24))

        flashcard = ft.Container(
            bgcolor=ft.Colors.WHITE,
            border=ft.Border(top=ft.BorderSide(1, BORDER_COLOR), bottom=ft.BorderSide(1, BORDER_COLOR), left=ft.BorderSide(1, BORDER_COLOR), right=ft.BorderSide(1, BORDER_COLOR)),
            border_radius=16, padding=40,
            content=ft.Column([
                ft.Row([
                    ft.Container(content=ft.Text("QUESTION", size=12, weight=ft.FontWeight.BOLD, color=PRIMARY_TEAL), bgcolor=LIGHT_TEAL, padding=ft.Padding(12, 6, 12, 6), border_radius=16),
                    ft.Text("General Physics", size=14, color=TEXT_GREY)
                ], alignment=ft.MainAxisAlignment.SPACE_BETWEEN),
                ft.Container(height=60),
                ft.Text("What is the dimension of Force?", size=32, weight=ft.FontWeight.BOLD, color=TEXT_DARK, text_align=ft.TextAlign.CENTER),
                ft.Text("Take a moment to recall the answer.", size=16, color=TEXT_GREY, text_align=ft.TextAlign.CENTER),
                ft.Container(height=60),
                ft.Row([
                    ft.Button(
                        content=ft.Row([ft.Icon(ft.Icons.VISIBILITY, color=ft.Colors.WHITE, size=18), ft.Text("Reveal answer", color=ft.Colors.WHITE, weight=ft.FontWeight.W_600)], spacing=8),
                        bgcolor=PRIMARY_TEAL, style=ft.ButtonStyle(padding=16, shape=ft.RoundedRectangleBorder(radius=8))
                    )
                ], alignment=ft.MainAxisAlignment.CENTER)
            ], horizontal_alignment=ft.CrossAxisAlignment.CENTER)
        )

        card_navigation = ft.Row([
            ft.Button(content=ft.Row([ft.Icon(ft.Icons.ARROW_BACK, size=18, color=PRIMARY_TEAL), ft.Text("Previous", color=PRIMARY_TEAL)]), bgcolor=LIGHT_TEAL, style=ft.ButtonStyle(padding=16, shape=ft.RoundedRectangleBorder(radius=8))),
            ft.Text("1 / 4", color=TEXT_GREY, size=14),
            ft.Button(content=ft.Row([ft.Text("Next", color=ft.Colors.WHITE), ft.Icon(ft.Icons.ARROW_FORWARD, size=18, color=ft.Colors.WHITE)], spacing=4), bgcolor=PRIMARY_TEAL, style=ft.ButtonStyle(padding=16, shape=ft.RoundedRectangleBorder(radius=8)))
        ], alignment=ft.MainAxisAlignment.SPACE_BETWEEN, margin=ft.Margin(0, 24, 0, 0))

        footer_text = ft.Text("Recall first, then reveal. Go at your own pace.", color=TEXT_GREY, size=13, text_align=ft.TextAlign.CENTER)

        return ft.Container(
            padding=40, expand=True,
            content=ft.Column([
                header_row, tabs_row, deck_title, flashcard, card_navigation,
                ft.Container(content=footer_text, alignment=ft.Alignment.CENTER, margin=ft.Margin(0, 24, 0, 0))
            ], scroll=ft.ScrollMode.AUTO)
        )

    # --- TAB SWITCHING ROUTER ---
    def switch_tab(tab_name):
        nonlocal active_tab
        active_tab = tab_name
        render_sidebar()
        
        if active_tab == "flashcards":
            main_content_container.content = build_flashcards_view()
        else:
            main_content_container.content = build_ai_study_view()
            
        page.update()

    # Initial Render
    render_sidebar()
    main_content_container.content = build_flashcards_view()

    # Floating Action Button
    page.floating_action_button = ft.FloatingActionButton(icon=ft.Icons.QUESTION_MARK, bgcolor="#374151", shape=ft.CircleBorder(), mini=True)

    # Page Assembly
    page.add(ft.Row([sidebar_container, main_content_container], expand=True, spacing=0))

if __name__ == "__main__":
    ft.run(main)